    <!-- ============================ App-wide ============================ -->
    <string name="app_name">FieldCon</string>
    <string name="app_title">Field Conditions Planner</string>
    <string name="app_tagline">Answers on question: when is it safe to work, and can you see what you\'re doing? Thermal guidance from published tables; light and darkness from on-device astronomical calculation. No network required.</string>
    <string name="app_disclaimer">Offline planning aid. Not a measuring instrument. You are responsible for the inputs you supply.</string>

